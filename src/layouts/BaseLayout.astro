---
import { ClientRouter } from 'astro:transitions';
import { SITE, NAV } from '../site.config';
import { PROFILE } from '../data/profile';
import { url } from '../lib/url';
import AnimatedBackground from '../components/AnimatedBackground.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  /** 语言切换时用来替换文档标题，对应 i18n.ts 里的键 */
  titleKey?: string;
  description?: string;
  /** true 时正文进入全文索引；列表页不索引，避免搜索结果重复 */
  indexable?: boolean;
  /** 正文页用窄栏 */
  narrow?: boolean;
}

const { title, titleKey, description = SITE.description, indexable = false, narrow = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.subtitle}`;
const current = Astro.url.pathname;
const attrs = indexable ? { 'data-pagefind-body': '' } : { 'data-pagefind-ignore': '' };

const isActive = (href: string) => {
  const target = url(href);
  return current === target || current.startsWith(target);
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme');
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        var lang = localStorage.getItem('lang');
        if (lang !== 'en' && lang !== 'zh') lang = 'zh';
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-title-key={titleKey}>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body>
    {SITE.ambient && <AnimatedBackground />}

    <header class="site-header" transition:persist="site-header" data-pagefind-ignore>
        <a class="brand" href={url()} data-i18n="nav.home">主页</a>
        <nav class="site-nav">
          {
            NAV.map((item) => (
              <a
                href={url(item.href)}
                data-i18n={item.key}
                class:list={{ active: isActive(item.href) }}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="header-tools">
          <button class="tool-btn" type="button" data-lang-toggle aria-label="切换到英文">EN</button>
          <button class="tool-btn" type="button" data-theme-toggle aria-label="切换到夜间">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
        <a class="icon-link" href={url('search/')} data-astro-prefetch="tap" data-i18n-label="nav.search" aria-label="搜索" title="搜索">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-3.6-3.6" stroke-linecap="round"></path>
          </svg>
        </a>
    </header>

    <main class:list={['wrap', narrow && 'wrap-narrow']} {...attrs}>
      <slot />
    </main>

    <footer class="site-footer" transition:persist="site-footer" data-pagefind-ignore>
      <div class="footer-line">
        <span>© {new Date().getFullYear()} <span data-i18n="site.name">{SITE.title}</span></span>
        <span>
          {
            PROFILE.links.map((link, index) => (
              <>
                {index > 0 && ' · '}
                <a href={link.href} data-astro-prefetch="false" rel="noopener">
                  {link.label}
                </a>
              </>
            ))
          }
          {' · '}
          <span data-i18n="footer.note">个人记录，转载请注明出处</span>
        </span>
      </div>
    </footer>
  </body>
</html>

<script>
  import { UI, type Lang } from '../i18n';

  (window as Window & { __ui?: typeof UI }).__ui = UI;

  const liveRoot = () => document.documentElement;

  const storedTheme = () => {
    const theme = localStorage.getItem('theme');
    return theme === 'light' || theme === 'dark' ? theme : null;
  };

  const storedLang = (): Lang | null => {
    const lang = localStorage.getItem('lang');
    return lang === 'en' || lang === 'zh' ? lang : null;
  };

  const applyStoredPrefs = (el: HTMLElement) => {
    const theme = storedTheme();
    const lang = storedLang();
    if (theme) el.dataset.theme = theme;
    if (lang) {
      el.dataset.lang = lang;
      el.lang = lang === 'en' ? 'en' : 'zh-CN';
    }
  };

  const currentLang = (): Lang =>
    liveRoot().dataset.lang === 'en' || storedLang() === 'en' ? 'en' : 'zh';

  const fill = (template: string, vars: string) => template.replaceAll('{n}', vars);

  const applyLang = () => {
    const root = liveRoot();
    applyStoredPrefs(root);
    const lang = currentLang();
    const dict = UI[lang];
    root.lang = lang === 'en' ? 'en' : 'zh-CN';

    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n as keyof typeof dict | undefined;
      const text = key ? dict[key] : undefined;
      if (!text) return;
      const vars = el.dataset.i18nVars;
      el.textContent = vars ? fill(text, vars) : text;
    });

    document.querySelectorAll<HTMLElement>('[data-i18n-label]').forEach((el) => {
      const key = el.dataset.i18nLabel as keyof typeof dict | undefined;
      const text = key ? dict[key] : undefined;
      if (!text) return;
      el.setAttribute('aria-label', text);
      if (el.hasAttribute('title')) el.setAttribute('title', text);
    });

    document.querySelectorAll<HTMLInputElement>('[data-i18n-placeholder]').forEach((el) => {
      const key = el.dataset.i18nPlaceholder as keyof typeof dict | undefined;
      const text = key ? dict[key] : undefined;
      if (text) el.placeholder = text;
    });

    const titleEl = document.querySelector('title');
    if (titleEl && !titleEl.dataset.zh) titleEl.dataset.zh = titleEl.textContent ?? '';
    const titleKey = titleEl?.dataset.titleKey;
    if (titleKey && titleKey in dict) {
      const value = dict[titleKey as keyof typeof dict];
      document.title = titleKey === 'doc.home' ? value : `${value} · ${dict['site.name']}`;
    } else if (titleEl?.dataset.zh) {
      document.title =
        lang === 'zh' ? titleEl.dataset.zh : titleEl.dataset.zh.replace(/何聪\s*$/, dict['site.name']);
    }

    const langBtn = document.querySelector<HTMLButtonElement>('[data-lang-toggle]');
    if (langBtn) {
      langBtn.textContent = lang === 'en' ? '中' : 'EN';
      langBtn.setAttribute('aria-label', lang === 'en' ? dict['lang.toggle'] : UI.zh['lang.toggle']);
      langBtn.setAttribute('aria-pressed', lang === 'en' ? 'true' : 'false');
    }
    const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (themeBtn) {
      const dark = liveRoot().dataset.theme === 'dark';
      themeBtn.setAttribute('aria-label', dark ? dict['theme.toLight'] : dict['theme.toDark']);
      themeBtn.setAttribute('aria-pressed', dark ? 'true' : 'false');
    }
  };

  const langBtn = document.querySelector<HTMLButtonElement>('[data-lang-toggle]');
  if (langBtn && langBtn.dataset.bound !== '1') {
    langBtn.dataset.bound = '1';
    langBtn.addEventListener('click', () => {
      const next: Lang = currentLang() === 'en' ? 'zh' : 'en';
      liveRoot().dataset.lang = next;
      localStorage.setItem('lang', next);
      applyLang();
    });
  }

  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (themeBtn && themeBtn.dataset.bound !== '1') {
    themeBtn.dataset.bound = '1';
    themeBtn.addEventListener('click', () => {
      const next = liveRoot().dataset.theme === 'dark' ? 'light' : 'dark';
      liveRoot().dataset.theme = next;
      localStorage.setItem('theme', next);
      applyLang();
    });
  }

  document.addEventListener('astro:before-swap', ((event: Event) => {
    const nextDoc = (event as Event & { newDocument?: Document }).newDocument;
    if (nextDoc?.documentElement) applyStoredPrefs(nextDoc.documentElement);
  }) as EventListener);
  document.addEventListener('astro:after-swap', applyLang);
  document.addEventListener('astro:page-load', applyLang);

  const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);

  // 顶栏被 persist 留在原地，当前页高亮要自己跟着路径改
  const markNav = () => {
    const current = normalize(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>('.site-nav a').forEach((link) => {
      const href = normalize(link.getAttribute('href') ?? '');
      const active = href !== '/' && (current === href || current.startsWith(href));
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };

  document.addEventListener('astro:page-load', markNav);
</script>
