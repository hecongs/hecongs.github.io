---
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getVisible } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisible('posts');
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[index + 1] ?? null,
      next: entries[index - 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<EntryLayout entry={entry} kind="posts" headings={headings} prev={prev} next={next}>
  <Content />
</EntryLayout>
